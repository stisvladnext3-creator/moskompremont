#!/bin/sh
# Data-only updater: the website supplies a URI, never a shell command or a package.
MKR_VERSION='0.1.5'
umask 077
[ "$(id -u)" = 0 ] || { printf '{"error":"root_required"}\n'; exit 1; }
STATE=/tmp/mkr-router
KEEP=/etc/mkr-router
LOCK=/var/lock/mkr-router.lock
mkdir -p "$STATE" "$KEEP" /var/lock || exit 1
chmod 700 "$STATE" "$KEEP" || exit 1

cfg() { uci -q get "mkr_router.main.$1" 2>/dev/null; }
sha() { sha256sum | cut -d ' ' -f1; }
text_sha() { printf '%s' "$1" | sha; }
number() { case "$1" in ''|*[!0-9]*) return 1;; esac; }
endpoint_ok() { printf '%s' "$1" | grep -Eq '^https://[^/@?#[:space:]]+(/[A-Za-z0-9_.~-]+)*/router-agent\.php$'; }
token_ok() { printf '%s' "$1" | grep -Eq '^mkr1\.[a-f0-9]{24}\.[a-f0-9]{64}$'; }
supported_uri() { printf '%s' "$1" | grep -Eq '^(vless|ss|trojan|hysteria2|hy2)://[^[:space:]]+$'; }
routing_mode_ok() { case "$1" in blocked|except_ru|all|podkop) return 0;; *) return 1;; esac; }
routing_mode_supported() { case "$1" in blocked) return 0;; all|except_ru) case "$(podkop_version)" in 0.7.*) return 0;; *) return 1;; esac;; *) return 1;; esac; }
list_has() { for item in $1; do [ "$item" = "$2" ] && return 0; done; return 1; }
list_without() { for item in $1; do [ "$item" = "$2" ] || printf '%s ' "$item"; done | sed 's/[[:space:]]*$//'; }
routing_section_name() { printf 'mkr_router_%s' "$TARGET"; }
routing_speedtest_section_name() { printf 'mkr_router_speedtest_%s' "$TARGET"; }
routing_hash_values() { printf '%s\n' "$TARGET" "$1" "$2" "$3" "$4" "$5" "$6" "$7" "$8" | sha; }
routing_hash_current() {
 local lists full lists_enabled user_type user_text exists owner managed_lists managed_connection managed_mode managed_lists_enabled managed_remote_subnets managed_domain_type managed_domains_text managed_signature speedtest_exists speedtest_owner
 lists="$(uci -q get "podkop.$TARGET.community_lists" 2>/dev/null)"
 full="$(uci -q get "podkop.$TARGET.fully_routed_ips" 2>/dev/null)"
 lists_enabled="$(uci -q get "podkop.$TARGET.community_lists_enabled" 2>/dev/null)"
 user_type="$(uci -q get "podkop.$TARGET.user_subnet_list_type" 2>/dev/null)"; user_text="$(uci -q get "podkop.$TARGET.user_subnets_text" 2>/dev/null)"
 exists=no; owner=''; managed_lists=''; managed_connection=''; managed_mode=''; managed_lists_enabled=''; managed_remote_subnets=''; managed_domain_type=''; managed_domains_text=''
 if [ "$(uci -q get "podkop.$MKR_SECTION" 2>/dev/null)" = section ]; then
  exists=yes; owner="$(uci -q get "podkop.$MKR_SECTION.mkr_router_owner" 2>/dev/null)"
  managed_lists="$(uci -q get "podkop.$MKR_SECTION.community_lists" 2>/dev/null)"
  managed_connection="$(uci -q get "podkop.$MKR_SECTION.connection_type" 2>/dev/null)"
  managed_mode="$(uci -q get "podkop.$MKR_SECTION.mode" 2>/dev/null)"
  managed_lists_enabled="$(uci -q get "podkop.$MKR_SECTION.community_lists_enabled" 2>/dev/null)"
  managed_remote_subnets="$(uci -q get "podkop.$MKR_SECTION.remote_subnet_lists" 2>/dev/null)"
   managed_domain_type="$(uci -q get "podkop.$MKR_SECTION.user_domain_list_type" 2>/dev/null)"
   managed_domains_text="$(uci -q get "podkop.$MKR_SECTION.user_domains_text" 2>/dev/null)"
 fi
 managed_signature="$managed_lists:$managed_connection:$managed_mode:$managed_remote_subnets"
 [ -n "$managed_domain_type$managed_domains_text" ] && managed_signature="$managed_signature:$managed_domain_type:$managed_domains_text"
 speedtest_exists=no; speedtest_owner=''
 if [ "$(uci -q get "podkop.$(routing_speedtest_section_name)" 2>/dev/null)" = section ]; then speedtest_exists=yes; speedtest_owner="$(uci -q get "podkop.$(routing_speedtest_section_name).mkr_router_owner" 2>/dev/null)"; fi
 routing_hash_values "$lists" "$full" "$lists_enabled:$user_type:$user_text" "$exists" "$owner" "$managed_signature" "$managed_lists_enabled" "$speedtest_exists:$speedtest_owner"
}
routing_capture() {
 MKR_SECTION="$(routing_section_name)"
 MKR_SPEEDTEST_SECTION="$(routing_speedtest_section_name)"
 OLD_LISTS="$(uci -q get "podkop.$TARGET.community_lists" 2>/dev/null)"
 OLD_FULL="$(uci -q get "podkop.$TARGET.fully_routed_ips" 2>/dev/null)"
 OLD_LISTS_ENABLED="$(uci -q get "podkop.$TARGET.community_lists_enabled" 2>/dev/null)"
 OLD_USER_SUBNET_TYPE="$(uci -q get "podkop.$TARGET.user_subnet_list_type" 2>/dev/null)"
 OLD_USER_SUBNET_TEXT="$(uci -q get "podkop.$TARGET.user_subnets_text" 2>/dev/null)"
 OLD_MANAGED_EXISTS=no; OLD_MANAGED_OWNER=''; OLD_MANAGED_LISTS=''; OLD_MANAGED_CONNECTION=''; OLD_MANAGED_MODE=''; OLD_MANAGED_LISTS_ENABLED=''; OLD_MANAGED_REMOTE_SUBNETS=''; OLD_MANAGED_DOMAIN_TYPE=''; OLD_MANAGED_DOMAINS_TEXT=''
 if [ "$(uci -q get "podkop.$MKR_SECTION" 2>/dev/null)" = section ]; then
  OLD_MANAGED_EXISTS=yes
  OLD_MANAGED_OWNER="$(uci -q get "podkop.$MKR_SECTION.mkr_router_owner" 2>/dev/null)"
  [ "$OLD_MANAGED_OWNER" = mkr-router ] || [ "$ROUTING_MODE" = podkop ] || return 1
  OLD_MANAGED_LISTS="$(uci -q get "podkop.$MKR_SECTION.community_lists" 2>/dev/null)"
  OLD_MANAGED_CONNECTION="$(uci -q get "podkop.$MKR_SECTION.connection_type" 2>/dev/null)"
  OLD_MANAGED_MODE="$(uci -q get "podkop.$MKR_SECTION.mode" 2>/dev/null)"
  OLD_MANAGED_LISTS_ENABLED="$(uci -q get "podkop.$MKR_SECTION.community_lists_enabled" 2>/dev/null)"
  OLD_MANAGED_REMOTE_SUBNETS="$(uci -q get "podkop.$MKR_SECTION.remote_subnet_lists" 2>/dev/null)"
  OLD_MANAGED_DOMAIN_TYPE="$(uci -q get "podkop.$MKR_SECTION.user_domain_list_type" 2>/dev/null)"
  OLD_MANAGED_DOMAINS_TEXT="$(uci -q get "podkop.$MKR_SECTION.user_domains_text" 2>/dev/null)"
 elif [ -n "$(uci -q get "podkop.$MKR_SECTION" 2>/dev/null)" ]; then
  [ "$ROUTING_MODE" = podkop ] || return 1
 fi
 if [ "$(uci -q get "podkop.$MKR_SPEEDTEST_SECTION" 2>/dev/null)" = section ]; then
  [ "$(uci -q get "podkop.$MKR_SPEEDTEST_SECTION.mkr_router_owner" 2>/dev/null)" = mkr-router ] || [ "$ROUTING_MODE" = podkop ] || return 1
 fi
 OLD_MANAGED_SIGNATURE="$OLD_MANAGED_LISTS:$OLD_MANAGED_CONNECTION:$OLD_MANAGED_MODE:$OLD_MANAGED_REMOTE_SUBNETS"
 [ -n "$OLD_MANAGED_DOMAIN_TYPE$OLD_MANAGED_DOMAINS_TEXT" ] && OLD_MANAGED_SIGNATURE="$OLD_MANAGED_SIGNATURE:$OLD_MANAGED_DOMAIN_TYPE:$OLD_MANAGED_DOMAINS_TEXT"
 ROUTING_SHA="$(routing_hash_values "$OLD_LISTS" "$OLD_FULL" "$OLD_LISTS_ENABLED:$OLD_USER_SUBNET_TYPE:$OLD_USER_SUBNET_TEXT" "$OLD_MANAGED_EXISTS" "$OLD_MANAGED_OWNER" "$OLD_MANAGED_SIGNATURE" "$OLD_MANAGED_LISTS_ENABLED" "$(uci -q get "podkop.$MKR_SPEEDTEST_SECTION" 2>/dev/null):$(uci -q get "podkop.$MKR_SPEEDTEST_SECTION.mkr_router_owner" 2>/dev/null)")"
}
batch_add_list() {
 local section="$1" option="$2" value="$3"
 jq -rn --arg section "$section" --arg option "$option" --arg value "$value" '"add_list podkop."+$section+"."+$option+"="+($value|@sh)'
}
routing_commit_batch() {
 local delta="$WORK/routing-delta"
 rm -rf "$delta"; mkdir -p "$delta" || return 1
 uci -q -t "$delta" batch < "$WORK/routing.batch" || return 1
 uci -q -t "$delta" commit podkop || return 1
}
routing_speedtest_batch() {
 local section="$MKR_SPEEDTEST_SECTION" uri="$(uci -q get "podkop.$TARGET.proxy_string" 2>/dev/null)" kind
 printf '%s\n' "delete podkop.$section" "set podkop.$section=section" "set podkop.$section.mkr_router_owner='mkr-router'" "set podkop.$section.proxy_config_type='url'" "set podkop.$section.proxy_string=$(printf '%s' "$uri" | jq -Rrs '@sh')" "set podkop.$section.user_domain_list_type='text'" "set podkop.$section.user_domains_text='speedtest.net ooklaserver.net ookla.com'" "set podkop.$section.community_lists_enabled='1'" >> "$WORK/routing.batch"
 case "$(podkop_version)" in 0.7.*) printf '%s\n' "set podkop.$section.connection_type='proxy'" >> "$WORK/routing.batch";; *) printf '%s\n' "set podkop.$section.mode='proxy'" >> "$WORK/routing.batch";; esac
 printf '%s\n' "reorder podkop.$section=0" >> "$WORK/routing.batch"
}
routing_set_lists() {
 local section="$1" option="$2" values="$3" value
 printf '%s\n' "delete podkop.$section.$option" > "$WORK/routing.batch"
 for value in $values; do batch_add_list "$section" "$option" "$value" >> "$WORK/routing.batch" || return 1; done
}
routing_restore() {
 local value
 routing_set_lists "$TARGET" community_lists "$OLD_LISTS" || return 1
 printf '%s\n' "delete podkop.$TARGET.fully_routed_ips" "set podkop.$TARGET.community_lists_enabled=$(printf '%s' "$OLD_LISTS_ENABLED" | jq -Rr '@sh')" >> "$WORK/routing.batch"
 for value in $OLD_FULL; do batch_add_list "$TARGET" fully_routed_ips "$value" >> "$WORK/routing.batch" || return 1; done
 printf '%s\n' "set podkop.$TARGET.user_subnet_list_type=$(printf '%s' "$OLD_USER_SUBNET_TYPE" | jq -Rrs '@sh')" "set podkop.$TARGET.user_subnets_text=$(printf '%s' "$OLD_USER_SUBNET_TEXT" | jq -Rrs '@sh')" >> "$WORK/routing.batch"
 if [ "$OLD_MANAGED_EXISTS" = yes ]; then
   printf '%s\n' "set podkop.$MKR_SECTION=section" "set podkop.$MKR_SECTION.mkr_router_owner='mkr-router'" "set podkop.$MKR_SECTION.connection_type=$(printf '%s' "$OLD_MANAGED_CONNECTION" | jq -Rr '@sh')" "set podkop.$MKR_SECTION.mode=$(printf '%s' "$OLD_MANAGED_MODE" | jq -Rr '@sh')" "set podkop.$MKR_SECTION.community_lists_enabled=$(printf '%s' "$OLD_MANAGED_LISTS_ENABLED" | jq -Rr '@sh')" >> "$WORK/routing.batch"
   if [ -n "$OLD_MANAGED_DOMAIN_TYPE" ]; then printf '%s\n' "set podkop.$MKR_SECTION.user_domain_list_type=$(printf '%s' "$OLD_MANAGED_DOMAIN_TYPE" | jq -Rrs '@sh')" >> "$WORK/routing.batch"; else printf '%s\n' "delete podkop.$MKR_SECTION.user_domain_list_type" >> "$WORK/routing.batch"; fi
   if [ -n "$OLD_MANAGED_DOMAINS_TEXT" ]; then printf '%s\n' "set podkop.$MKR_SECTION.user_domains_text=$(printf '%s' "$OLD_MANAGED_DOMAINS_TEXT" | jq -Rrs '@sh')" >> "$WORK/routing.batch"; else printf '%s\n' "delete podkop.$MKR_SECTION.user_domains_text" >> "$WORK/routing.batch"; fi
  printf '%s\n' "delete podkop.$MKR_SECTION.community_lists" >> "$WORK/routing.batch"
  for value in $OLD_MANAGED_LISTS; do batch_add_list "$MKR_SECTION" community_lists "$value" >> "$WORK/routing.batch" || return 1; done
  printf '%s\n' "delete podkop.$MKR_SECTION.remote_subnet_lists" >> "$WORK/routing.batch"
  for value in $OLD_MANAGED_REMOTE_SUBNETS; do batch_add_list "$MKR_SECTION" remote_subnet_lists "$value" >> "$WORK/routing.batch" || return 1; done
 else
  printf '%s\n' "delete podkop.$MKR_SECTION" >> "$WORK/routing.batch"
 fi
 printf '%s\n' "delete podkop.$MKR_SPEEDTEST_SECTION" >> "$WORK/routing.batch"
 routing_commit_batch
}
routing_apply_mode() {
 local lists full add_russia add_full add_lists_enabled add_world lists_enabled user_type user_text value
 lists="$OLD_LISTS"; full="$OLD_FULL"; add_russia="$(cfg routing_added_russia_inside)"; add_full="$(cfg routing_added_full_route)"
 add_lists_enabled="$(cfg routing_added_lists_enabled)"; add_world="$(cfg routing_added_world_routes)"; lists_enabled="$OLD_LISTS_ENABLED"; user_type="$OLD_USER_SUBNET_TYPE"; user_text="$OLD_USER_SUBNET_TEXT"
 routing_mode_ok "$ROUTING_MODE" || return 1
 case "$ROUTING_MODE" in
 podkop)
  # Leave every Podkop routing option exactly as the administrator configured it.
  return 0
  ;;
 blocked)
  if list_has "$lists" russia_outside || list_has "$lists" ukraine_inside; then return 2; fi
  if ! list_has "$lists" russia_inside; then lists="$lists russia_inside"; add_russia=1; else add_russia=0; fi
  if [ "$lists_enabled" != 1 ]; then lists_enabled=1; add_lists_enabled=1; else add_lists_enabled=0; fi
  if list_has "$full" 0.0.0.0/0; then
   [ "$add_full" = 1 ] || return 2
   full="$(list_without "$full" 0.0.0.0/0)"
  fi
  if [ "$add_world" = 1 ]; then user_type=disabled; user_text=''; else if [ "$user_type" != '' ] && [ "$user_type" != disabled ] && [ -n "$user_text" ]; then return 2; fi; fi
  routing_set_lists "$TARGET" community_lists "$lists" || return 1
  printf '%s\n' "delete podkop.$TARGET.fully_routed_ips" "set podkop.$TARGET.community_lists_enabled='${lists_enabled}'" "set podkop.$TARGET.user_subnet_list_type=$(printf '%s' "$user_type" | jq -Rrs '@sh')" "set podkop.$TARGET.user_subnets_text=$(printf '%s' "$user_text" | jq -Rrs '@sh')" "delete podkop.$MKR_SECTION" >> "$WORK/routing.batch"
  for value in $full; do batch_add_list "$TARGET" fully_routed_ips "$value" >> "$WORK/routing.batch" || return 1; done
  routing_speedtest_batch
  ;;
 all)
  routing_mode_supported all || return 3
  if ! list_has "$full" 0.0.0.0/0; then full="$full 0.0.0.0/0"; add_full=1; fi
  if [ "$add_world" = 1 ]; then user_type=text; user_text='0.0.0.0/0 ::/0'; else if [ "$user_type" != '' ] && [ "$user_type" != disabled ] && [ -n "$user_text" ]; then return 2; else user_type=text; user_text='0.0.0.0/0 ::/0'; add_world=1; fi; fi
  routing_set_lists "$TARGET" community_lists "$lists" || return 1
  printf '%s\n' "delete podkop.$MKR_SECTION" "set podkop.$TARGET.user_subnet_list_type='${user_type}'" "set podkop.$TARGET.user_subnets_text=$(printf '%s' "$user_text" | jq -Rrs '@sh')" >> "$WORK/routing.batch"
  printf '%s\n' "delete podkop.$TARGET.fully_routed_ips" >> "$WORK/routing.batch"
  for value in $full; do batch_add_list "$TARGET" fully_routed_ips "$value" >> "$WORK/routing.batch" || return 1; done
  routing_speedtest_batch
  ;;
 except_ru)
  routing_mode_supported except_ru || return 3
  if ! list_has "$full" 0.0.0.0/0; then full="$full 0.0.0.0/0"; add_full=1; fi
  # Older releases installed a catch-all destination text list. Remove only
  # the list owned by this package; Podkop's source route preserves localv4.
  remove_world=no
  if [ "$add_world" = 1 ]; then
   [ "$user_type" = text ] && [ "$user_text" = '0.0.0.0/0 ::/0' ] || return 2
   remove_world=yes; add_world=0
  fi
  routing_set_lists "$TARGET" community_lists "$lists" || return 1
  if [ "$remove_world" = yes ]; then printf '%s\n' "delete podkop.$TARGET.user_subnet_list_type" "delete podkop.$TARGET.user_subnets_text" >> "$WORK/routing.batch"; fi
  printf '%s\n' "delete podkop.$TARGET.fully_routed_ips" "set podkop.$MKR_SECTION=section" "set podkop.$MKR_SECTION.mkr_router_owner='mkr-router'" "set podkop.$MKR_SECTION.connection_type='exclusion'" "set podkop.$MKR_SECTION.mode='exclusion'" "set podkop.$MKR_SECTION.community_lists_enabled='1'" "set podkop.$MKR_SECTION.user_subnet_list_type='dynamic'" "delete podkop.$MKR_SECTION.user_subnets" "add_list podkop.$MKR_SECTION.user_subnets='192.168.31.1'" "delete podkop.$MKR_SECTION.user_domain_list_type" "delete podkop.$MKR_SECTION.user_domains_text" "delete podkop.$MKR_SECTION.community_lists" "delete podkop.$MKR_SECTION.remote_subnet_lists" "add_list podkop.$MKR_SECTION.remote_subnet_lists='https://raw.githubusercontent.com/SagerNet/sing-geoip/rule-set/geoip-ru.srs'" "reorder podkop.$MKR_SECTION=1" >> "$WORK/routing.batch"
  routing_speedtest_batch
  for value in $full; do batch_add_list "$TARGET" fully_routed_ips "$value" >> "$WORK/routing.batch" || return 1; done
  ;;
 esac
 routing_commit_batch || return 1
 ADDED_RUSSIA="$add_russia"; ADDED_FULL="$add_full"; ADDED_LISTS_ENABLED="$add_lists_enabled"; ADDED_WORLD="$add_world"
 return 0
}
routing_release_managed() {
 local lists="$OLD_LISTS" full="$OLD_FULL" value
 [ "$(cfg routing_added_russia_inside)" = 1 ] && lists="$(list_without "$lists" russia_inside)"
 [ "$(cfg routing_added_full_route)" = 1 ] && full="$(list_without "$full" 0.0.0.0/0)"
 routing_set_lists "$TARGET" community_lists "$lists" || return 1
 printf '%s\n' "delete podkop.$TARGET.fully_routed_ips" >> "$WORK/routing.batch"
 for value in $full; do batch_add_list "$TARGET" fully_routed_ips "$value" >> "$WORK/routing.batch" || return 1; done
 if [ "$(cfg routing_added_lists_enabled)" = 1 ]; then printf '%s\n' "set podkop.$TARGET.community_lists_enabled='0'" >> "$WORK/routing.batch"; fi
 if [ "$(cfg routing_added_world_routes)" = 1 ]; then
  if [ "$OLD_USER_SUBNET_TYPE" = text ] && [ "$OLD_USER_SUBNET_TEXT" = '0.0.0.0/0 ::/0' ]; then printf '%s\n' "delete podkop.$TARGET.user_subnet_list_type" "delete podkop.$TARGET.user_subnets_text" >> "$WORK/routing.batch"; fi
 fi
 if [ "$(uci -q get "podkop.$MKR_SECTION.mkr_router_owner" 2>/dev/null)" = mkr-router ]; then printf '%s\n' "delete podkop.$MKR_SECTION" >> "$WORK/routing.batch"; fi
 if [ "$(uci -q get "podkop.$MKR_SPEEDTEST_SECTION.mkr_router_owner" 2>/dev/null)" = mkr-router ]; then printf '%s\n' "delete podkop.$MKR_SPEEDTEST_SECTION" >> "$WORK/routing.batch"; fi
 routing_commit_batch
}

load_settings() {
 ENABLED="$(cfg enabled)"; MODE="$(cfg mode)"; ENDPOINT="$(cfg endpoint)"; TOKEN="$(cfg token)"; SECTION="$(cfg section)"; BASELINE="$(cfg baseline)"; ROUTING_BASELINE="$(cfg routing_baseline)"; ROUTING_MODE="$(cfg routing_mode)"; ROUTING_APPLIED_MODE="$(cfg routing_applied_mode)"; DEVICE="$(cfg device_id)"
 [ -n "$ROUTING_MODE" ] || ROUTING_MODE=blocked
 SETTINGS="$(printf '%s\n' "$ENABLED" "$MODE" "$ENDPOINT" "$TOKEN" "$SECTION" "$ROUTING_MODE" | sha)"
}
same_settings() {
 local configured_mode
 configured_mode="$(cfg routing_mode)"; [ -n "$configured_mode" ] || configured_mode=blocked
 [ "$SETTINGS" = "$(printf '%s\n' "$(cfg enabled)" "$(cfg mode)" "$(cfg endpoint)" "$(cfg token)" "$(cfg section)" "$configured_mode" | sha)" ]
}
state() {
 jq -n --arg state "$1" --arg reason "${2:-}" --argjson checked "$(date +%s)" '{state:$state,reason:$reason,checked_at:$checked}' > "$STATE/state.new"
 mv "$STATE/state.new" "$STATE/state.json"
}
version_number() {
 sed -nE 's/^v?([0-9]+\.[0-9]+\.[0-9]+)([-+~][A-Za-z0-9._+~-]+)?$/\1/p' | head -n1
}
podkop_version() {
 local found
 # apk 3 info -v describes the package; -e -v prints its installed version.
 # Try both managers: some upgraded firmware retains an opkg compatibility shim.
 if command -v apk >/dev/null 2>&1; then
  found="$(apk info -e -v podkop 2>/dev/null | sed -n 's/^podkop-//p' | version_number)"
  if [ -n "$found" ]; then printf '%s\n' "$found"; return; fi
 fi
 if command -v opkg >/dev/null 2>&1; then
  found="$(opkg status podkop 2>/dev/null | sed -n 's/^Version: *//p' | version_number)"
  if [ -n "$found" ]; then printf '%s\n' "$found"; return; fi
 fi
 # Official 0.7 builds embed the version here. Read data, never source shell.
 if [ -r /usr/lib/podkop/constants.sh ]; then
  sed -n 's/^[[:space:]]*PODKOP_VERSION[[:space:]]*=[[:space:]]*//p' /usr/lib/podkop/constants.sh | head -n1 | tr -d "\"'[:space:]" | version_number
 fi
}
version_ok() { case "$(podkop_version)" in 0.3.*|0.4.*|0.5.*|0.6.*|0.7.*) return 0;; *) return 1;; esac; }
proxy_section() {
 local connection
 connection="$(uci -q get "podkop.$1.connection_type" 2>/dev/null)"
 if [ -n "$connection" ]; then
  [ "$(uci -q get "podkop.$1" 2>/dev/null)" = section ] && [ "$connection" = proxy ]
 else
  [ "$(uci -q get "podkop.$1.mode" 2>/dev/null)" = proxy ]
 fi
}
targets() {
 uci -q show podkop 2>/dev/null | sed -n 's/^podkop\.\([A-Za-z0-9_]*\)=[^=]*$/\1/p' | while IFS= read -r section; do
  [ -n "$section" ] || continue
  kind="$(uci -q get "podkop.$section.proxy_config_type" 2>/dev/null)"
  proxy_section "$section" || continue
  jq -cn --arg id "$section" --arg kind "$kind" '{id:$id,type:$kind,supported:($kind=="url")}'
 done | jq -s '.'
}
target() {
 TARGET="$SECTION"
 if [ -z "$TARGET" ]; then
  targets > "$WORK/targets.json"
  [ "$(jq '[.[]|select(.supported)]|length' "$WORK/targets.json")" = 1 ] || return 1
  TARGET="$(jq -r '.[]|select(.supported)|.id' "$WORK/targets.json")"
 fi
 printf '%s' "$TARGET" | grep -Eq '^[A-Za-z0-9_]+$' || return 1
 proxy_section "$TARGET" && [ "$(uci -q get "podkop.$TARGET.proxy_config_type" 2>/dev/null)" = url ] || return 1
 CURRENT="$(uci -q get "podkop.$TARGET.proxy_string" 2>/dev/null)"
 # Multiline/manual fallback lists belong to the user. Never erase their backup entries.
 [ "$(printf '%s' "$CURRENT" | wc -l)" = 0 ] || return 1
 CURRENT_SHA="$(text_sha "$CURRENT")"
  routing_capture || return 1
 return 0
}
write_options() {
 # jq's @sh quoting is consumed by UCI's parser, not by a shell; no URI/token is an argv value.
 package="$1"; file="$2"; delta="$WORK/uci-delta"
 mkdir -p "$delta"
 jq -r --arg package "$package" 'to_entries[]|"set "+$package+".main."+.key+"="+(.value|tostring|@sh)' "$file" > "$WORK/options.batch" || return 1
 uci -q -t "$delta" batch < "$WORK/options.batch" || return 1
 uci -q -t "$delta" commit "$package" || return 1
 chmod 600 "/etc/config/$package"
}
binding() {
 same_settings || return 1
 jq -n --arg baseline "$1" --arg routing "$2" --arg schema "${ROUTING_SCHEMA:-$(cfg routing_schema)}" --arg applied_mode "${BINDING_APPLIED_MODE:-$ROUTING_MODE}" --arg device "$DEVICE" --arg added_russia "${ADDED_RUSSIA:-$(cfg routing_added_russia_inside)}" --arg added_full "${ADDED_FULL:-$(cfg routing_added_full_route)}" --arg added_lists_enabled "${ADDED_LISTS_ENABLED:-$(cfg routing_added_lists_enabled)}" --arg added_world "${ADDED_WORLD:-$(cfg routing_added_world_routes)}" --arg routing_section "${TARGET:-$(cfg routing_section)}" '{baseline:$baseline,routing_baseline:$routing,routing_schema:$schema,routing_applied_mode:$applied_mode,routing_added_russia_inside:$added_russia,routing_added_full_route:$added_full,routing_added_lists_enabled:$added_lists_enabled,routing_added_world_routes:$added_world,routing_section:$routing_section,device_id:$device}' > "$WORK/binding.json" || return 1
 write_options mkr_router "$WORK/binding.json"
}
transfer() {
 url_file="$1"; output="$2"; auth="$3"; post="${4:-}"
 jq -r '"url = "+@json' "$url_file" > "$WORK/curl.conf"
 if [ "$auth" = yes ]; then printf '%s' "$TOKEN" > "$WORK/token"; jq -Rrs '"header = "+("X-MKR-Router-Token: "+.|@json)' "$WORK/token" >> "$WORK/curl.conf"; fi
 if [ -n "$post" ]; then printf '%s\n' 'header = "Content-Type: application/json"' >> "$WORK/curl.conf"; fi
 if [ -n "$post" ]; then
  HTTP="$(curl --config "$WORK/curl.conf" --proto '=https' --tlsv1.2 --silent --connect-timeout 8 --max-time 25 --max-filesize 262144 --output "$output" --write-out '%{http_code}' --data-binary "@$post" 2> "$WORK/curl.error")" || return 1
 else
  HTTP="$(curl --config "$WORK/curl.conf" --proto '=https' --tlsv1.2 --silent --connect-timeout 8 --max-time 25 --max-filesize 262144 --output "$output" --write-out '%{http_code}' 2> "$WORK/curl.error")" || return 1
 fi
 [ -f "$output" ] && [ "$(wc -c < "$output")" -le 262144 ]
}
report() {
 [ -n "$REVISION" ] || return 0
 jq -n --arg state "$1" --arg revision "$REVISION" --arg version "$MKR_VERSION" '{state:$state,revision:$revision,client_version:$version}' > "$WORK/report.json"
 printf '%s' "$ENDPOINT" | jq -Rs '.' > "$WORK/site-url.json"
 transfer "$WORK/site-url.json" "$WORK/report-reply.json" yes "$WORK/report.json" >/dev/null 2>&1 || :
}
identity() {
 # Host changes are expected. Pin a subscription node by protocol, credential, port and label.
 value="$1"; scheme="${value%%://*}"; rest="${value#*://}"; authority="${rest%%\?*}"; authority="${authority%%#*}"
 case "$scheme" in vless|trojan|hysteria2|hy2) ;; *) return 1;; esac
 case "$authority" in *@*:* ) ;; *) return 1;; esac
 credential="${authority%@*}"; address="${authority##*@}"; port="${address##*:}"
 number "$port" || return 1
 fragment=''; case "$value" in *\#*) fragment="${value#*#}";; esac
 printf '%s|%s|%s|%s' "$scheme" "$credential" "$port" "$fragment"
}
resolve_value() {
 jq -r '.resource.value' "$WORK/snapshot.json" > "$WORK/source.txt"
 source_value="$(cat "$WORK/source.txt")"
 if supported_uri "$source_value"; then NEW="$source_value"; printf '%s' "$NEW" | jq -Rs '[.]' > "$WORK/candidates.json"; return 0; fi
 case "$source_value" in https://*) ;; *) printf '[]' > "$WORK/candidates.json"; return 1;; esac
 jq '.resource.value' "$WORK/snapshot.json" > "$WORK/sub-url.json"
 transfer "$WORK/sub-url.json" "$WORK/subscription.txt" no && [ "$HTTP" = 200 ] || return 1
 if ! grep -Eq '^(vless|ss|trojan|hysteria2|hy2)://' "$WORK/subscription.txt"; then
  tr -d ' \r\n\t' < "$WORK/subscription.txt" | tr '_-' '/+' > "$WORK/base64.txt"
  case $(( $(wc -c < "$WORK/base64.txt") % 4 )) in 2) printf '==' >> "$WORK/base64.txt";; 3) printf '=' >> "$WORK/base64.txt";; 1) return 1;; esac
  base64 -d < "$WORK/base64.txt" > "$WORK/decoded.txt" 2>/dev/null || return 1
 else cp "$WORK/subscription.txt" "$WORK/decoded.txt"; fi
 tr -d '\r' < "$WORK/decoded.txt" | grep -E '^(vless|ss|trojan|hysteria2|hy2)://[^[:space:]]+$' | head -n 256 > "$WORK/uris.txt"
 jq -Rn '[inputs]' < "$WORK/uris.txt" > "$WORK/candidates.json"
 [ "$(jq length "$WORK/candidates.json")" -gt 0 ] || return 1
 wanted="$(identity "$CURRENT")" || return 1
 : > "$WORK/matches"
 while IFS= read -r uri; do [ "$(identity "$uri")" = "$wanted" ] && printf '%s\n' "$uri" >> "$WORK/matches"; done < "$WORK/uris.txt"
 [ "$(wc -l < "$WORK/matches")" = 1 ] || return 1
 NEW="$(cat "$WORK/matches")"; return 0
}
pending() {
 [ -f "$WORK/candidates.json" ] || printf '[]' > "$WORK/candidates.json"
 printf '%s' "${NEW:-}" > "$WORK/new-value"
 jq --slurpfile candidates "$WORK/candidates.json" --rawfile value "$WORK/new-value" '{label:.resource.label,resource_type:.resource.type,device_id:.device_id,value:$value,source_value:.resource.value,candidates:$candidates[0]}' "$WORK/snapshot.json" > "$STATE/pending.new"
 mv "$STATE/pending.new" "$STATE/pending.json"
}
config_value() {
 # Use an isolated delta. Do not commit another LuCI tab's unsaved changes.
 [ -z "$(uci -q changes podkop 2>/dev/null)" ] || return 1
 delta="$WORK/podkop-delta"; mkdir -p "$delta"
 printf '%s' "$1" > "$WORK/value" || return 1
 jq -Rrs --arg section "$TARGET" '"set podkop."+$section+".proxy_string="+(.|@sh)' "$WORK/value" > "$WORK/value.batch" || return 1
 uci -q -t "$delta" batch < "$WORK/value.batch" || return 1
 [ -z "$(uci -q changes podkop 2>/dev/null)" ] || return 1
 uci -q -t "$delta" commit podkop || return 1
 [ "$(text_sha "$(uci -q get "podkop.$TARGET.proxy_string" 2>/dev/null)")" = "$(text_sha "$1")" ]
}
sing_box_running() { /etc/init.d/sing-box running >/dev/null 2>&1; }
routing_present() { nft list table inet PodkopTable >/dev/null 2>&1; }
podkop_state() {
 # Podkop is a one-shot initializer. Its process normally exits while sing-box
 # and the NFT table remain active. Do not confuse that with a stopped VPN.
 [ -x /etc/init.d/sing-box ] && command -v nft >/dev/null 2>&1 || { printf unknown; return; }
 if /etc/init.d/podkop running >/dev/null 2>&1; then printf starting
 elif routing_present; then if sing_box_running; then printf active; else printf inconsistent; fi
 elif sing_box_running; then printf inconsistent
 else printf stopped; fi
}
healthy() {
 config_path="$(uci -q get podkop.settings.config_path 2>/dev/null)"
 [ -n "$config_path" ] || config_path="$(uci -q get podkop.main.config_path 2>/dev/null)"
 [ -n "$config_path" ] || config_path=/etc/sing-box/config.json
 [ -f "$config_path" ] && sing-box check -c "$config_path" >/dev/null 2>&1 && sing_box_running && routing_present
}
rollback() {
 # Restore only our proxy/routing fields; concurrent edits to DNS or other sections survive.
 now_value="$(uci -q get "podkop.$TARGET.proxy_string" 2>/dev/null)"
 now_routing="$(routing_hash_current)"
 if [ "$(text_sha "$now_value")" = "$(text_sha "$CURRENT")" ] && [ "$now_routing" = "$ROUTING_SHA" ]; then rm -f "$KEEP/journal.json"; return 0; fi
 [ "$(text_sha "$now_value")" = "$REVISION" ] || return 1
 [ -z "$AFTER_ROUTING" ] || [ "$now_routing" = "$AFTER_ROUTING" ] || return 1
 config_value "$CURRENT" || return 1
 [ "${ROUTING_UNTOUCHED:-no}" = yes ] || routing_restore || return 1
 if [ "$WAS_RUNNING" = yes ]; then /etc/init.d/podkop restart 9>&- >/dev/null 2>&1 || return 1; fi
 rm -f "$KEEP/journal.json"
}
apply_value() {
 same_settings || { state manual settings_changed; return 1; }
 version_ok && target || { state manual unsupported_podkop; return 1; }
 [ -z "$(uci -q changes podkop 2>/dev/null)" ] || { state manual unsaved_changes; return 1; }
 routing_mode_ok "$ROUTING_MODE" || { state manual routing_mode; return 1; }
 if [ "$ROUTING_MODE" = podkop ] && [ -n "$ROUTING_APPLIED_MODE" ] && [ "$ROUTING_APPLIED_MODE" != podkop ]; then routing_release_managed || { state failed write_failed; return 1; }; ROUTING_SHA="$(routing_hash_current)"; fi
 [ -n "$BASELINE" ] && [ "$CURRENT_SHA" = "$BASELINE" ] && { [ "$ROUTING_MODE" = podkop ] || [ -z "$ROUTING_BASELINE" ] || [ "$ROUTING_SHA" = "$ROUTING_BASELINE" ]; } || { state manual local_changed; return 1; }
 WAS_RUNNING=no
 case "$(podkop_state)" in active) WAS_RUNNING=yes;; stopped) ;; *) state manual runtime_state; report manual; return 0;; esac
 cp /etc/config/podkop "$KEEP/podkop.backup" && chmod 600 "$KEEP/podkop.backup" && printf '%s' "$CURRENT" > "$KEEP/previous-value" || { state failed backup_failed; return 1; }
 ROUTING_UNTOUCHED=no; [ "$ROUTING_MODE" != podkop ] || ROUTING_UNTOUCHED=yes
  jq -n --arg untouched "$ROUTING_UNTOUCHED" --arg section "$TARGET" --arg revision "$REVISION" --arg old "$CURRENT_SHA" --arg running "$WAS_RUNNING" --arg routing "$ROUTING_SHA" --arg lists "$OLD_LISTS" --arg full "$OLD_FULL" --arg lists_enabled "$OLD_LISTS_ENABLED" --arg user_type "$OLD_USER_SUBNET_TYPE" --arg user_text "$OLD_USER_SUBNET_TEXT" --arg managed_exists "$OLD_MANAGED_EXISTS" --arg managed_owner "$OLD_MANAGED_OWNER" --arg managed_lists "$OLD_MANAGED_LISTS" --arg managed_connection "$OLD_MANAGED_CONNECTION" --arg managed_mode "$OLD_MANAGED_MODE" --arg managed_lists_enabled "$OLD_MANAGED_LISTS_ENABLED" --arg managed_remote_subnets "$OLD_MANAGED_REMOTE_SUBNETS" --arg managed_domain_type "$OLD_MANAGED_DOMAIN_TYPE" --arg managed_domains_text "$OLD_MANAGED_DOMAINS_TEXT" '{routing_untouched:$untouched,section:$section,revision:$revision,previous:$old,running:$running,routing_previous:$routing,old_lists:$lists,old_full:$full,old_lists_enabled:$lists_enabled,old_user_subnet_type:$user_type,old_user_subnets_text:$user_text,old_managed_exists:$managed_exists,old_managed_owner:$managed_owner,old_managed_lists:$managed_lists,old_managed_connection:$managed_connection,old_managed_mode:$managed_mode,old_managed_lists_enabled:$managed_lists_enabled,old_managed_remote_subnets:$managed_remote_subnets,old_managed_domain_type:$managed_domain_type,old_managed_domains_text:$managed_domains_text,after_routing:""}' > "$KEEP/journal.new" && mv "$KEEP/journal.new" "$KEEP/journal.json" || { state failed backup_failed; return 1; }
 state applying ''
 if ! config_value "$NEW"; then if rollback; then state failed write_failed; else state manual rollback_failed; fi; report failed; return 1; fi
 routing_apply_mode; route_result=$?
 if [ "$route_result" -ne 0 ]; then
  if rollback; then [ "$route_result" = 2 ] && state manual routing_conflict || [ "$route_result" = 3 ] && state manual unsupported_routing || state failed write_failed; else state manual rollback_failed; fi
  report failed; return 1
 fi
 AFTER_ROUTING="$(routing_hash_current)"
 jq --arg after "$AFTER_ROUTING" '.after_routing=$after' "$KEEP/journal.json" > "$KEEP/journal.new" && mv "$KEEP/journal.new" "$KEEP/journal.json" || { if rollback; then state failed binding_failed; else state manual rollback_failed; fi; report failed; return 1; }
 if [ "$WAS_RUNNING" = yes ]; then
  if ! /etc/init.d/podkop restart 9>&- > "$WORK/restart.log" 2>&1; then
   if rollback; then state failed restart_failed; else state manual rollback_failed; fi; report failed; return 1
  fi
  ready=no
  attempt=0
  while [ "$attempt" -lt 45 ]; do sleep 2; if healthy; then ready=yes; break; fi; attempt=$((attempt + 1)); done
  if [ "$ready" != yes ]; then if rollback; then state failed check_failed; else state manual rollback_failed; fi; report failed; return 1; fi
 fi
 [ "$ROUTING_MODE" != except_ru ] || ROUTING_SCHEMA=2
 binding "$REVISION" "$AFTER_ROUTING" || { state failed binding_failed; return 1; }
 rm -f "$KEEP/journal.json" "$STATE/pending.json"
 state applied ''; report applied
 logger -t mkr-router 'Connection configuration updated' 2>/dev/null || :
}
recover() {
 [ -f "$KEEP/journal.json" ] || return 0
 ROUTING_UNTOUCHED="$(jq -r '.routing_untouched // "no"' "$KEEP/journal.json")"
  TARGET="$(jq -r '.section' "$KEEP/journal.json")"; REVISION="$(jq -r '.revision' "$KEEP/journal.json")"; WAS_RUNNING="$(jq -r '.running' "$KEEP/journal.json")"; AFTER_ROUTING="$(jq -r '.after_routing // empty' "$KEEP/journal.json")"; CURRENT="$(cat "$KEEP/previous-value" 2>/dev/null)"
 printf '%s' "$TARGET" | grep -Eq '^[A-Za-z0-9_]+$' || return 1
 [ "$(text_sha "$CURRENT")" = "$(jq -r '.previous' "$KEEP/journal.json")" ] || return 1
  MKR_SECTION="mkr_router_${TARGET}"; MKR_SPEEDTEST_SECTION="mkr_router_speedtest_${TARGET}"; OLD_LISTS="$(jq -r '.old_lists // ""' "$KEEP/journal.json")"; OLD_FULL="$(jq -r '.old_full // ""' "$KEEP/journal.json")"; OLD_LISTS_ENABLED="$(jq -r '.old_lists_enabled // ""' "$KEEP/journal.json")"; OLD_USER_SUBNET_TYPE="$(jq -r '.old_user_subnet_type // ""' "$KEEP/journal.json")"; OLD_USER_SUBNET_TEXT="$(jq -r '.old_user_subnets_text // ""' "$KEEP/journal.json")"; OLD_MANAGED_EXISTS="$(jq -r '.old_managed_exists // "no"' "$KEEP/journal.json")"; OLD_MANAGED_OWNER="$(jq -r '.old_managed_owner // ""' "$KEEP/journal.json")"; OLD_MANAGED_LISTS="$(jq -r '.old_managed_lists // ""' "$KEEP/journal.json")"; OLD_MANAGED_CONNECTION="$(jq -r '.old_managed_connection // ""' "$KEEP/journal.json")"; OLD_MANAGED_MODE="$(jq -r '.old_managed_mode // ""' "$KEEP/journal.json")"; OLD_MANAGED_LISTS_ENABLED="$(jq -r '.old_managed_lists_enabled // ""' "$KEEP/journal.json")"; OLD_MANAGED_REMOTE_SUBNETS="$(jq -r '.old_managed_remote_subnets // ""' "$KEEP/journal.json")"; OLD_MANAGED_DOMAIN_TYPE="$(jq -r '.old_managed_domain_type // ""' "$KEEP/journal.json")"; OLD_MANAGED_DOMAINS_TEXT="$(jq -r '.old_managed_domains_text // ""' "$KEEP/journal.json")"; ROUTING_SHA="$(jq -r '.routing_previous' "$KEEP/journal.json")"
  now_routing="$(routing_hash_current)"
  if [ "$(text_sha "$(uci -q get "podkop.$TARGET.proxy_string" 2>/dev/null)")" = "$(text_sha "$CURRENT")" ] && [ "$now_routing" = "$ROUTING_SHA" ]; then rm -f "$KEEP/journal.json"; return 0; fi
 if rollback; then state failed recovered; else state manual recovery_conflict; return 1; fi
}
check() {
 load_settings; REVISION=''; NEW=''; CURRENT=''; CURRENT_SHA=''; rm -f "$STATE/pending.json"
 [ "$ENABLED" = 1 ] && token_ok "$TOKEN" && endpoint_ok "$ENDPOINT" || { state unconfigured ''; return 0; }
 state checking ''
 printf '%s' "$ENDPOINT" | jq -Rs '.' > "$WORK/site-url.json"
 if ! transfer "$WORK/site-url.json" "$WORK/snapshot.json" yes; then state failed network; return 1; fi
 case "$HTTP" in 200) ;; 401|403) state auth ''; return 1;; 410) state unavailable ''; return 1;; 422) state manual unsupported_source; return 1;; 429) state failed rate_limit; return 1;; *) state failed server; return 1;; esac
 jq -e '.version==1 and (.device_id|type=="number") and (.resource.value|type=="string") and (.resource.revision|type=="string" and length==64 and (explode|all((.>=48 and .<=57) or (.>=97 and .<=102)))) and (.resource.value|length>0 and length<=8192 and (explode|all(.>32 and .!=127)))' "$WORK/snapshot.json" >/dev/null 2>&1 || { state failed invalid_response; return 1; }
 source_value="$(jq -r '.resource.value' "$WORK/snapshot.json")"
 [ "$(text_sha "$source_value")" = "$(jq -r '.resource.revision' "$WORK/snapshot.json")" ] || { state failed invalid_response; return 1; }
 new_device="$(jq -r '.device_id' "$WORK/snapshot.json")"
 [ -z "$DEVICE" ] || [ "$DEVICE" = "$new_device" ] || { state auth wrong_device; return 1; }; DEVICE="$new_device"
 supported=no; target && version_ok && supported=yes
 routing_mode_ok "$ROUTING_MODE" || { state manual routing_mode; report manual; return 0; }
 if ! resolve_value; then pending; REVISION="$(jq -r '.resource.revision' "$WORK/snapshot.json")"; state manual choose_node; report manual; return 0; fi
 REVISION="$(text_sha "$NEW")"; pending
 printf '%s' "$NEW" | grep -Eq '^(vless|ss|trojan)://' || { state manual unsupported_protocol; report manual; return 0; }
 [ "$supported" = yes ] || { state manual unsupported_podkop; report manual; return 0; }
 [ -z "$(uci -q changes podkop 2>/dev/null)" ] || { state manual unsaved_changes; return 0; }
 same_settings || { state manual settings_changed; return 1; }
 if [ "$CURRENT_SHA" = "$REVISION" ]; then
  if [ -n "$BASELINE" ] && [ "$BASELINE" != "$CURRENT_SHA" ]; then state manual local_changed; report manual; return 0; fi
  if [ "$ROUTING_MODE" != podkop ] && [ -n "$ROUTING_BASELINE" ] && [ "$ROUTING_BASELINE" != "$ROUTING_SHA" ]; then state manual local_changed; report manual; return 0; fi
  if [ -z "$BASELINE" ] || [ -z "$ROUTING_BASELINE" ]; then BINDING_APPLIED_MODE="$ROUTING_APPLIED_MODE"; binding "$CURRENT_SHA" "$ROUTING_SHA" || { unset BINDING_APPLIED_MODE; return 1; }; unset BINDING_APPLIED_MODE; BASELINE="$CURRENT_SHA"; ROUTING_BASELINE="$ROUTING_SHA"; fi
  if [ "$ROUTING_MODE" = podkop ]; then
   if [ -n "$ROUTING_APPLIED_MODE" ] && [ "$ROUTING_APPLIED_MODE" != podkop ]; then routing_release_managed || { state failed write_failed; return 1; }; ROUTING_SHA="$(routing_hash_current)"; fi
   binding "$CURRENT_SHA" "$ROUTING_SHA" || return 1
   rm -f "$STATE/pending.json"; state current ''; report current; return 0
  fi
  if [ "$ROUTING_APPLIED_MODE" != "$ROUTING_MODE" ] || { [ "$ROUTING_MODE" = except_ru ] && [ "$(cfg routing_schema)" != 2 ]; }; then
   if [ "$MODE" = auto ] || [ "$1" = force ]; then apply_value
   else state available ''; report available
   fi
   return 0
  fi
  if [ "$BASELINE" != "$CURRENT_SHA" ] || [ "$ROUTING_BASELINE" != "$ROUTING_SHA" ] || [ "$(cfg device_id)" != "$DEVICE" ]; then BINDING_APPLIED_MODE="$ROUTING_APPLIED_MODE"; binding "$CURRENT_SHA" "$ROUTING_SHA" || { unset BINDING_APPLIED_MODE; return 1; }; unset BINDING_APPLIED_MODE; fi
  rm -f "$STATE/pending.json"; state current ''; report current; return 0
 fi
 if [ -z "$BASELINE" ]; then BINDING_APPLIED_MODE="$ROUTING_APPLIED_MODE"; binding "$CURRENT_SHA" "$ROUTING_SHA" || { unset BINDING_APPLIED_MODE; return 1; }; unset BINDING_APPLIED_MODE; BASELINE="$CURRENT_SHA"; ROUTING_BASELINE="$ROUTING_SHA"; fi
 [ "$BASELINE" = "$CURRENT_SHA" ] && { [ "$ROUTING_MODE" = podkop ] || [ -z "$ROUTING_BASELINE" ] || [ "$ROUTING_BASELINE" = "$ROUTING_SHA" ]; } || { state manual local_changed; report manual; return 0; }
 if [ "$MODE" = auto ] || [ "$1" = force ]; then apply_value
 else state available ''; report available; fi
}
configure() {
 cat > "$WORK/input.json"
 [ "$(wc -c < "$WORK/input.json")" -le 4096 ] || return 1
 jq -e '(.mode=="auto" or .mode=="notify") and (.routing_mode=="blocked" or .routing_mode=="except_ru" or .routing_mode=="all" or .routing_mode=="podkop") and (.interval|type=="number" and .>=300 and .<=86400 and floor==.) and (.section|type=="string" and (explode|all((.>=48 and .<=57) or (.>=65 and .<=90) or (.>=97 and .<=122) or .==95))) and (.endpoint|type=="string" and (explode|all(.>32 and .!=127))) and (.token|type=="string" and (explode|all(.>32 and .!=127)))' "$WORK/input.json" >/dev/null 2>&1 || return 1
 endpoint="$(jq -r '.endpoint' "$WORK/input.json")"; endpoint_ok "$endpoint" || return 1
 token="$(jq -r '.token' "$WORK/input.json")"; [ -n "$token" ] || token="$(cfg token)"; token_ok "$token" || return 1
 printf '%s' "$token" > "$WORK/config-token"
 section="$(jq -r '.section' "$WORK/input.json")"
 current=''; [ -z "$section" ] || current="$(uci -q get "podkop.$section.proxy_string" 2>/dev/null)"
 # An empty automatic section binds only after resolving a single supported target.
 baseline=''; [ -z "$section" ] || baseline="$(text_sha "$current")"
 old_section="$(cfg routing_section)"; reset='{}'
 if [ -n "$old_section" ] && [ "$old_section" != "$section" ]; then reset='{"routing_baseline":"","routing_applied_mode":"","routing_added_russia_inside":"0","routing_added_full_route":"0","routing_added_lists_enabled":"0","routing_added_world_routes":"0","routing_section":""}'; fi
 if [ "$(cfg routing_mode)" = podkop ] && [ "$(jq -r '.routing_mode' "$WORK/input.json")" != podkop ]; then reset='{"routing_baseline":"","routing_applied_mode":"","routing_added_russia_inside":"0","routing_added_full_route":"0","routing_added_lists_enabled":"0","routing_added_world_routes":"0"}'; fi
 jq --rawfile token "$WORK/config-token" --arg baseline "$baseline" --argjson reset "$reset" '{mode,routing_mode,interval,section,endpoint}+{token:$token,enabled:"1",baseline:$baseline,device_id:""}+$reset' "$WORK/input.json" > "$WORK/settings.json" || return 1
 write_options mkr_router "$WORK/settings.json" || return 1
 rm -f "$STATE/pending.json"; state configured ''; printf '{"ok":true}\n'
}
status() {
 read_dir="$(mktemp -d "$STATE/read.XXXXXX")" || return 1
 if [ -f "$STATE/state.json" ]; then cp "$STATE/state.json" "$read_dir/state.json"; else printf '{"state":"unconfigured","reason":""}' > "$read_dir/state.json"; fi
 targets > "$read_dir/targets.json"
 routing_mode="$(cfg routing_mode)"; [ -n "$routing_mode" ] || routing_mode=blocked
 jq -n --slurpfile state "$read_dir/state.json" --slurpfile targets "$read_dir/targets.json" --arg version "$MKR_VERSION" --arg mode "$(cfg mode)" --arg routing_mode "$routing_mode" --arg endpoint "$(cfg endpoint)" --arg section "$(cfg section)" --arg interval "$(cfg interval)" --arg podkop "$(podkop_version)" --arg token "$([ -n "$(cfg token)" ] && echo yes)" '$state[0]+{version:$version,targets:$targets[0],settings:{mode:$mode,routing_mode:$routing_mode,endpoint:$endpoint,section:$section,interval:($interval|tonumber? //900),has_token:($token=="yes")},podkop_version:$podkop}' > "$read_dir/status.json"
 if [ -f "$STATE/pending.json" ]; then jq --slurpfile pending "$STATE/pending.json" '.+{pending:$pending[0]}' "$read_dir/status.json"; else cat "$read_dir/status.json"; fi
 rm -rf "$read_dir"
}

case "${1:-status}" in
 status) status; exit;;
 daemon) sleep 45; while :; do "$0" check >/dev/null 2>&1; interval="$(cfg interval)"; number "$interval" && [ "$interval" -ge 300 ] && [ "$interval" -le 86400 ] || interval=900; sleep "$interval"; done;;
esac
exec 9>"$LOCK"
if ! flock -n 9; then printf '{"error":"busy"}\n'; exit 75; fi
WORK="$(mktemp -d "$STATE/work.XXXXXX")" || exit 1
trap 'rm -rf "$WORK"' EXIT
trap 'exit 143' HUP INT TERM
case "$1" in
 configure) recover && configure || { printf '{"error":"invalid_settings"}\n'; exit 1; };;
 disable) printf '{"enabled":"0","token":"","baseline":"","device_id":""}' > "$WORK/off.json"; write_options mkr_router "$WORK/off.json" || exit 1; rm -f "$STATE/pending.json"; if recover; then state unconfigured ''; else state manual recovery_conflict; fi; printf '{"ok":true}\n';;
 check) recover && check normal;;
 apply) recover && check force;;
 recover) recover;;
 *) printf '{"error":"unknown_command"}\n'; exit 1;;
esac
