#!/bin/sh
case "$1" in
 list) printf '%s\n' '{"status":{},"check":{},"apply":{},"disable":{},"configure":{"mode":"","routing_mode":"","interval":0,"section":"","endpoint":"","token":""},"versions":{},"upgrade":{"version":""},"upgrade_status":{}}';;
 call)
  case "$2" in
   status|disable) exec /usr/bin/mkr-router "$2";;
   check|apply) /usr/bin/mkr-router "$2" </dev/null >/dev/null 2>&1 & printf '{"accepted":true}\n';;
   configure)
    if /usr/bin/mkr-router configure; then /usr/bin/mkr-router check </dev/null >/dev/null 2>&1 & fi;;
   versions) exec /usr/bin/mkr-package versions;;
   upgrade)
    version="$(jq -r '.version // ""')"
    if printf '%s' "$version" | grep -Eq '^[0-9]+\.[0-9]+\.[0-9]+$'; then
     /usr/bin/mkr-package install "$version" </dev/null >/dev/null 2>&1 & printf '{"accepted":true}\n'
    else printf '{"error":"invalid_version"}\n'; fi;;
   upgrade_status) exec /usr/bin/mkr-package status;;
   *) printf '{"error":"unknown_method"}\n';;
  esac;;
esac
