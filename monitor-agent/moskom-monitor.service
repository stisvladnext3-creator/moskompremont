[Unit]
Description=MosKomRemont subscription availability monitor
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=mkr-monitor
Group=mkr-monitor
ExecStart=/usr/bin/python3 /opt/moskom-monitor/monitor.py --config /etc/moskom-monitor/config.json
Restart=on-failure
RestartSec=15
TimeoutStopSec=25
KillMode=control-group
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX AF_NETLINK
UMask=0077
Environment=GOMAXPROCS=2
Nice=10
MemoryMax=512M
TasksMax=256

[Install]
WantedBy=multi-user.target
