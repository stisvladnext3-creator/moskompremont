# Controller only. Copy to .env, chmod 600 .env; do not commit real values.
TELEGRAM_BOT_TOKEN=replace-with-token-from-BotFather
TELEGRAM_ADMIN_IDS=123456789
PROBE_RU_TOKEN=replace-with-random-secret-of-at-least-32-characters
XUI_NL_TOKEN=replace-with-3x-ui-api-token
XUI_DE_TOKEN=replace-with-3x-ui-api-token
# For 2.x instead of API tokens:
# XUI_NL_USERNAME=admin
# XUI_NL_PASSWORD=replace-me
# XUI_DE_USERNAME=admin
# XUI_DE_PASSWORD=replace-me

# Optional public HTTPS deployment via compose.public.yml:
MONITOR_DOMAIN=monitor.example.com
