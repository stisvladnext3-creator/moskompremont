# Add inside an existing HTTPS server block with its valid TLS certificate.
# No access log: probe URLs and timestamps do not need to be public logs.
location /v1/probes/ {
    access_log off;
    client_max_body_size 128k;
    proxy_pass http://127.0.0.1:8080;
    proxy_set_header Host $host;
    proxy_set_header Authorization $http_authorization;
    proxy_read_timeout 30s;
}
